{
  "expo": {
    "name": "K1 Gym & Fitness Center",
    "slug": "k1-gym",
    "version": "1.0.0",
    "description": "Complete gym management system with member roster, plans, renewals, and analytics",
    "owner": "avnishbhosales-organization",
    "userInterfaceStyle": "dark",
    "jsEngine": "jsc",
    "icon": "./assets/icon.jpg",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "jsEngine": "jsc",
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font"
    ],
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "android": {
      "package": "com.k1gym.fitnesscenter",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#0c0c0f"
      }
    },
    "ios": {
      "bundleIdentifier": "com.k1gym.fitnesscenter",
      "buildNumber": "1",
      "icon": "./assets/icon.jpg"
    },
    "extra": {
      "eas": {
        "projectId": "c9dd00d5-6814-4505-9350-6fcb6d24557f"
      }
    }
  }
}
