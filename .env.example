# K1 Gym deployment environment

# Public build/runtime flags
NODE_ENV=production
EXPO_PUBLIC_APP_ENV=production

# Supabase client configuration
# Use your project URL from Supabase Project Settings > API.
# It should look like https://project-ref.supabase.co, not https://supabase.com/.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Optional: kept for hosts or scripts that check React Native Web explicitly
REACT_NATIVE_WEB=true

# GitHub Actions / hosting secrets
# Store these in the host or GitHub secret manager, not in .env.local.
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_org_id_here
VERCEL_PROJECT_ID=your_project_id_here
NETLIFY_AUTH_TOKEN=your_netlify_token_here
NETLIFY_SITE_ID=your_netlify_site_id_here

# Local development example
# NODE_ENV=development
# EXPO_PUBLIC_APP_ENV=development
